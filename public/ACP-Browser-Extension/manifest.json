{
  "manifest_version": 3,
  "name": "GrandRP ACP Bridge — DC Checker",
  "version": "1.6.0",
  "description": "Liest SocialClub und BannGrund aus dem Grand RP Admin Panel und sendet sie token-geschützt an den DC Checker.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://admin.gta5grand.com/*",
    "https://*.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://admin.gta5grand.com/*"],
      "js": ["website-bridge.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://*.github.io/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["dc-receiver.js"],
      "run_at": "document_start"
    }
  ]
}
